# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Stripe
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# PlayHQ (obtain API key from GCA)
PLAYHQ_API_KEY=your-playhq-api-key
PLAYHQ_ORG_ID=2c2bff9c

# Resend app transactional email (server-only; separate from Supabase Auth email)
# Used by lib/email.ts for app notifications only. Missing values skip email without blocking form submissions.
RESEND_API_KEY=re_xxx
RESEND_FROM_EMAIL=NDCC Dinos <noreply@ndcc.com.au>
# Legacy alias still supported by the app if RESEND_FROM_EMAIL is not set.
RESEND_FROM=

# Bank transfer details used in order/event/member emails (server-only)
NDCC_BANK_ACCOUNT_NAME=
NDCC_BANK_BSB=
NDCC_BANK_ACCOUNT_NUMBER=

# Supabase Auth confirmation/reset emails are configured in Supabase Dashboard -> Authentication -> SMTP Settings,
# not through the app's Resend API email helper or any app route.
# Use Resend SMTP credentials there only after Resend domain sending is verified.
SUPABASE_AUTH_SMTP_HOST=smtp.resend.com
SUPABASE_AUTH_SMTP_PORT=465
SUPABASE_AUTH_SMTP_USER=resend
SUPABASE_AUTH_SMTP_PASS=re_xxx
SUPABASE_AUTH_SMTP_SENDER_NAME=NDCC Dinos
SUPABASE_AUTH_SMTP_ADMIN_EMAIL=noreply@ndcc.com.au

# Site
NEXT_PUBLIC_SITE_URL=https://www.ndcc.com.au

# GitHub-backed CMS media uploads (server-only; configure in Vercel env vars)
GITHUB_CONTENTS_TOKEN=ghp_xxx
GITHUB_REPO_OWNER=your-org-or-user
GITHUB_REPO_NAME=ndcc-website
GITHUB_CONTENTS_BRANCH=main
GITHUB_MEDIA_BASE_PATH=public/images/cms
GITHUB_COMMITTER_NAME=NDCC CMS Bot
GITHUB_COMMITTER_EMAIL=bot@example.com
VERCEL_DEPLOY_HOOK_URL=
