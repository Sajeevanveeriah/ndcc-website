# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Stripe
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# PlayHQ (obtain API key from GCA)
PLAYHQ_API_KEY=your-playhq-api-key
PLAYHQ_ORG_ID=2c2bff9c

# Site
NEXT_PUBLIC_SITE_URL=https://www.ndcc.com.au

# GitHub-backed CMS media uploads (server-only; configure in Vercel env vars)
GITHUB_CONTENTS_TOKEN=ghp_xxx
GITHUB_REPO_OWNER=your-org-or-user
GITHUB_REPO_NAME=ndcc-website
GITHUB_CONTENTS_BRANCH=main
GITHUB_MEDIA_BASE_PATH=public/images/cms
GITHUB_COMMITTER_NAME=NDCC CMS Bot
GITHUB_COMMITTER_EMAIL=bot@example.com
VERCEL_DEPLOY_HOOK_URL=
