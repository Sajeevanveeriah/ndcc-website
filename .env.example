# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Payments (server-only)
# PAYMENT_PROVIDER selects the payment path: manual (bank-transfer enquiry, the
# current live mode), stripe_payment_link (per-product Payment Link buttons), or
# stripe_checkout (Stripe Checkout Sessions via /api/checkout). Live checkout only
# activates when PAYMENT_PROVIDER=stripe_checkout AND STRIPE_SECRET_KEY is set.
PAYMENT_PROVIDER=manual
# Keep true until the club deliberately goes live with real charges.
PAYMENT_TEST_MODE=true

# Stripe (only needed for the stripe_* payment modes)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# PlayHQ Public API (server-only, never NEXT_PUBLIC)
PLAYHQ_API_BASE_URL=https://api.playhq.com
PLAYHQ_TENANT=ca
PLAYHQ_API_KEY=replace_with_playhq_public_api_key
PLAYHQ_ORGANISATION_ID=replace_with_playhq_organisation_id
PLAYHQ_DEFAULT_SEASON_ID=
PLAYHQ_DEFAULT_GRADE_IDS=
PLAYHQ_CACHE_REVALIDATE_SECONDS=3600

# PlayHQ Fantasy scheduled sync (server-only). CRON_SECRET guards
# /api/cron/playhq-fantasy-sync (Authorization: Bearer <CRON_SECRET>); Vercel
# sends it automatically when CRON_SECRET is set on the project. The cron fires
# daily at 16:30 UTC (02:30/03:30 Australia/Melbourne depending on daylight
# saving) and runs the full orchestrator: discover + link the PlayHQ season,
# discover NDCC grades, create/resume the bounded import job, validate and
# auto-publish clean batches, and record health in fantasy_sync_runs. Admins
# can also run it on demand from /admin/fantasy/seasons.
CRON_SECRET=
PLAYHQ_FANTASY_SYNC_ENABLED=false
PLAYHQ_FANTASY_SYNC_BATCH_SIZE=10


# Temporary admin auth readiness diagnostics (server-only; keep disabled unless diagnosing CMS login)
ADMIN_AUTH_READINESS_ENABLED=false
ADMIN_DIAGNOSTIC_TOKEN=
DIAGNOSTIC_MUTATION_ENABLED=false

# Resend app transactional email (server-only; separate from Supabase Auth email)
# Used by lib/email.ts for app notifications only. Missing values skip email without blocking form submissions.
RESEND_API_KEY=re_xxx
RESEND_FROM_EMAIL="NDCC Dinos <noreply@ndcc.com.au>"
# Legacy alias still supported by the app if RESEND_FROM_EMAIL is not set.
RESEND_FROM=
# When true, emails are logged/simulated instead of sent — use for local dev and
# smoke tests. Must be unset or false in production.
EMAIL_TEST_MODE=false
# Contact/enquiry notification recipients (server-only). CONTACT_TO_EMAIL falls
# back to the secretary inbox when unset; CC/BCC accept comma-separated lists.
CONTACT_TO_EMAIL=
CONTACT_CC_EMAILS=
CONTACT_BCC_EMAILS=

# Bank transfer details used in order/event/member emails (server-only)
NDCC_BANK_ACCOUNT_NAME=
NDCC_BANK_BSB=
NDCC_BANK_ACCOUNT_NUMBER=

# Supabase Auth confirmation/reset emails are configured in Supabase Dashboard -> Authentication -> SMTP Settings,
# not through the app's Resend API email helper or any app route.
# Use Resend SMTP credentials there only after Resend domain sending is verified.
SUPABASE_AUTH_SMTP_HOST=smtp.resend.com
SUPABASE_AUTH_SMTP_PORT=465
SUPABASE_AUTH_SMTP_USER=resend
SUPABASE_AUTH_SMTP_PASS=re_xxx
SUPABASE_AUTH_SMTP_SENDER_NAME=NDCC Dinos
SUPABASE_AUTH_SMTP_ADMIN_EMAIL=noreply@ndcc.com.au

# Site
NEXT_PUBLIC_SITE_URL=https://www.ndcc.com.au

# GitHub-backed CMS media uploads (server-only; configure in Vercel env vars)
GITHUB_CONTENTS_TOKEN=ghp_xxx
GITHUB_REPO_OWNER=your-org-or-user
GITHUB_REPO_NAME=ndcc-website
GITHUB_CONTENTS_BRANCH=main
GITHUB_MEDIA_BASE_PATH=public/images/cms
GITHUB_COMMITTER_NAME=NDCC CMS Bot
GITHUB_COMMITTER_EMAIL=bot@example.com
# Note: do NOT set a Vercel deploy hook for uploads. The CMS commit on main already
# triggers Vercel's git auto-deploy; a hook would fire a second deployment for the
# same commit and Vercel would cancel both, leaving the image unpublished.
